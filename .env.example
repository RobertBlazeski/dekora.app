# Copy this to .env and fill in real values. Never commit the real .env file.

# A strong, unique password for the production Postgres user (not the dev "5939" one).
POSTGRES_PASSWORD=change-me-to-a-strong-random-password

# Signs JWT auth tokens. Must be a long random string (32+ characters). Generate one with:
# openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-string

# The two domains this deploys to. Caddy automatically provisions HTTPS certificates for
# whatever is set here via Let's Encrypt, so both must already point at this server's IP.
CUSTOMER_DOMAIN=dekora.mk
ADMIN_DOMAIN=admin.dekora.mk

# Optional: real email delivery for order notifications and password-reset links. Leave
# EMAIL_ENABLED=false (or unset) and the API just logs what it would have sent instead of
# failing — useful until real SMTP credentials exist. Any SMTP provider works (a transactional
# email service like SendGrid/Mailgun/Amazon SES's SMTP endpoint, or a regular mailbox that
# allows SMTP/app-password auth).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@dekora.mk

# Optional: owner order notifications via Telegram (free, no business verification needed).
# Create a bot with @BotFather on Telegram to get this token; leave blank to skip Telegram.
TELEGRAM_BOT_TOKEN=

# The "Translate" buttons in the admin dashboard (product names/descriptions, extras, FAQ
# entries) use MyMemory's free translation API to draft an English/Albanian version of whatever
# Macedonian text the owner typed. No setup needed — no API key, no account, nothing to add here.
